<?xml version="1.0" encoding="UTF-8"?>
<!-- OrderId-correlated logging (T005, FR-008): every handling log line carries
     the reservation orderId via MDC key "orderId" (populated by the REST
     controller and the Kafka consumer; empty when no reservation in scope). -->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{orderId}] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <logger name="com.example.inventory_service" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
